# EduQuest — root environment (Docker Compose)
ENV=development
DEBUG=true
LOG_LEVEL=INFO

APP_NAME=EduQuest
APP_VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://eduquest:eduquest@db:5432/eduquest
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=dev-secret-change-me-eduquest-phase1
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
TIMEZONE=Asia/Kolkata
