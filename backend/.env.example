# Local development defaults (SQLite — no Docker required)
ENV=development
DEBUG=true
LOG_LEVEL=INFO
AUTO_CREATE_TABLES=true
JWT_SECRET_KEY=dev-secret-change-me-eduquest
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","https://student-syllabus-tracker-gilt.vercel.app"]
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp"]
REDIS_URL=redis://127.0.0.1:6379/0
# Coins awarded once on first successful topic quiz (>=60%)
COIN_REWARD_PER_TOPIC=10

# Optional Postgres (uncomment when Docker DB is running):
# DATABASE_URL=postgresql+asyncpg://eduquest:eduquest@127.0.0.1:5432/eduquest
